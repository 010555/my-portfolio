---
import { siteConfig } from "../config";

// يقبل دراسة واحدة كـ prop ليعمل لاحقاً داخل /work/[slug] دون تعديل
interface Props {
  study: (typeof siteConfig.caseStudies)[number];
  index?: number;
}

const { study, index } = Astro.props;

// ترقيم بفارغين ليحاذب عمود الأرقام بقية الأرقام عند تجاوز دراسة واحدة
const projectNumber = (i: number) => String(i + 1).padStart(2, "0");

// تسمية موحّدة لتسميات الأقسام الفرعية: صغيرة ومتتبّعة بدلاً من Caps بارزة
const labelClass = "meta-label";
---

<article class="group relative case-study-card">
  {/* خط فاصل علوي يتحول إلى لون accent عند التحويم — إشارة إلى قسم قابل للقراءة.
      نستخدم motion-safe: بدل motion-reduce: لأن قاعدة group-hover أعلى تخصيصاً
      (0,2,0) من قاعدة motion-reduce (0,1,0)، فتفوز قاعدة التحويم وتبقى الحركة */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-standard ease-standard motion-safe:group-hover:scale-x-100"
  />

  {/* ---------- الهوية: الترقيم والنوع والعنوان والملخص ---------- */}
  <div class="pt-8 sm:pt-10">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
      {
        index !== undefined && (
          <span class="text-sm tabular-nums text-muted">
            {projectNumber(index)}
          </span>
        )
      }
      {
        study.type && (
          <span class="meta-label">
            {study.type}
          </span>
        )
      }
    </div>

    {/* 24px على الجوال حتى لا ينكسر العنوان إلى ثلاثة أسطر في عمود 256px */}
    <h3 class="project-title">
      {study.title}
    </h3>

    <p class="lead-copy project-summary">
      {study.summary}
    </p>

    {
      study.link && (
        <a
          href={study.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${study.title}`}
          class="group/link project-link mt-4"
        >
          <span class="underline decoration-gray-300 underline-offset-[6px] transition-colors duration-fast motion-safe:group-hover/link:decoration-accent">
            View project
          </span>
          <svg
            class="w-4 h-4 transition-transform duration-standard ease-standard motion-safe:group-hover/link:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      )
    }
  </div>

  {/* ---------- السرد مقابل المواصفات ---------- */}
  <div class="case-study-grid">
    {/* السرد: لماذا بُني المشروع وكيف */}
    <div class="space-y-10">
      <div>
        <h4 class={labelClass}>Purpose</h4>
        <p class="body-copy mt-3">
          {study.purpose}
        </p>
      </div>

      <div>
        <h4 class={labelClass}>Approach</h4>
        <p class="body-copy mt-3">
          {study.approach}
        </p>
      </div>

      <div>
        <h4 class={labelClass}>Role</h4>
        <p class="body-copy mt-3">
          {study.role}
        </p>
      </div>
    </div>

    {/* المواصفات: ما بُني فعلياً وبأي تقنيات */}
    <div class="case-study-facts">
      <div>
        <h4 class={labelClass}>Capabilities</h4>
        {/* قائمة القدرات عمود واحد: عمودان كانا يلويان كل عنصر إلى سطرين وثلاثة */}
        <ul class="mt-4 space-y-2.5">
          {
            study.capabilities.map((capability) => (
              <li class="supporting-copy">
                {capability}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10">
        <h4 class={labelClass}>Stack</h4>
        {/* تقنيات كنص عادي لا كشارات داكنة: عمودان كانا يكسران "Django REST Framework" إلى سطرين */}
        <ul class="mt-4 space-y-1.5">
          {
            study.stack.map((item) => (
              <li class="supporting-copy">{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10">
        <h4 class={labelClass}>Outcomes</h4>
        <ul class="mt-4 space-y-3">
          {
            study.outcomes.map((outcome) => (
              <li class="supporting-copy">
                {outcome}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</article>
