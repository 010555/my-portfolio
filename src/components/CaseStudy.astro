---
import { siteConfig } from "../config";

// يقبل دراسة واحدة كـ prop ليعمل لاحقاً داخل /work/[slug] دون تعديل
interface Props {
  study: (typeof siteConfig.caseStudies)[number];
  index?: number;
}

const { study, index } = Astro.props;
---

<article
  class="relative bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 p-5 sm:p-6 md:p-8 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300"
>
  {
    study.link && (
      <a
        href={study.link}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open ${study.title}`}
        class="absolute top-5 right-5 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 hover:bg-gray-700"
      >
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 17L17 7M17 7H7M17 7V17"
          />
        </svg>
      </a>
    )
  }

  <div class="space-y-6">
    <div class={study.link ? "pr-12 sm:pr-14 md:pr-16" : ""}>
      {
        index !== undefined && (
          <span
            class="text-sm font-mono"
            style={{ color: siteConfig.accentColor }}
          >
            0{index + 1}
          </span>
        )
      }
      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
        {study.title}
      </h3>
      {
        study.type && (
          <span class="inline-block mt-3 px-3 py-1 text-xs sm:text-sm font-medium rounded-full bg-white border border-gray-300 text-gray-700">
            {study.type}
          </span>
        )
      }
    </div>

    <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
      {study.summary}
    </p>

    <div class="space-y-5">
      <div>
        <h4
          class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
        >
          Purpose
        </h4>
        <p class="mt-1.5 text-sm sm:text-base text-gray-600 leading-relaxed">
          {study.purpose}
        </p>
      </div>

      <div>
        <h4
          class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
        >
          Approach
        </h4>
        <p class="mt-1.5 text-sm sm:text-base text-gray-600 leading-relaxed">
          {study.approach}
        </p>
      </div>

      <div>
        <h4
          class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
        >
          Role
        </h4>
        <p class="mt-1.5 text-sm sm:text-base text-gray-600 leading-relaxed">
          {study.role}
        </p>
      </div>
    </div>

    <div>
      <h4
        class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
      >
        Capabilities
      </h4>
      <ul class="mt-3 space-y-2">
        {
          study.capabilities.map((capability) => (
            <li class="flex items-start">
              <span
                class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0"
                style={{ backgroundColor: siteConfig.accentColor }}
                aria-hidden="true"
              />
              <span class="text-sm sm:text-base text-gray-600">
                {capability}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4
        class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
      >
        Stack
      </h4>
      <ul class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
        {
          study.stack.map((item) => (
            <li class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4
        class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500"
      >
        Outcomes
      </h4>
      <ul class="mt-3 space-y-2">
        {
          study.outcomes.map((outcome) => (
            <li class="flex items-start">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
              <span class="text-sm sm:text-base text-gray-600">{outcome}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
