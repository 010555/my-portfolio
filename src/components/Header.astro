---
import { siteConfig } from "../config";

const navItems: { href: string; label: string }[] = [];
if (siteConfig.services?.length) {
  navItems.push({ href: "#services", label: "Services" });
}
if (siteConfig.caseStudies?.length) {
  navItems.push({ href: "#work", label: "Selected Work" });
}
if (siteConfig.capabilities?.length) {
  navItems.push({ href: "#capabilities", label: "Capabilities" });
}
if (siteConfig.social?.email) {
  navItems.push({ href: "#contact", label: "Contact" });
}
---

<header
  id="header"
  class="site-header fixed top-0 left-0 right-0 z-50"
>
  <nav class="layout-container nav-container nav-layout">
    <a href="#hero" class="desktop-brand hidden md:flex">
      {siteConfig.name}
    </a>
    <!-- شريط الجوال: الاسم + زر القائمة -->
    <div class="md:hidden flex w-full items-center justify-between">
      <a
        href="#hero"
        class="font-bold text-ink truncate pr-4"
        aria-label="Back to top"
      >
        {siteConfig.name}
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
        class="nav-toggle -mr-2 text-body hover:text-ink transition-colors duration-fast"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- روابط سطح المكتب -->
    <ul class="hidden md:flex items-center gap-8 justify-center md:ml-auto">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link font-medium"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden hidden bg-page border-b border-line"
  >
    <ul class="layout-container py-2">
      {
        navItems.map((item) => (
          <li class="border-b border-line last:border-b-0">
            <a
              href={item.href}
              class="nav-link py-3 font-medium"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // قائمة الجوال: نفس كود Inline بلا أي مكتبة خارجية
  const header = document.getElementById("header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const closeMenu = () => {
    menu?.classList.add("hidden");
    header?.classList.remove("bg-white");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation menu");
  };

  const openMenu = () => {
    menu?.classList.remove("hidden");
    header?.classList.add("bg-white");
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Close navigation menu");
  };

  toggle?.addEventListener("click", () => {
    toggle.getAttribute("aria-expanded") === "true"
      ? closeMenu()
      : openMenu();
  });

  // إغلاق بعد الانتقال إلى أي قسم
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // الإغلاق بمفتاح Escape مع إعادة التركيز للزر
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle.focus();
    }
  });

  // الإغلاق عند العودة لعرض سطح المكتب
  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 768px)").matches) {
      closeMenu();
    }
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 100) {
      header?.classList.add("is-scrolled");
    } else {
      header?.classList.remove("is-scrolled");
    }
  });
</script>

<style>
  @media (max-width: 47.999rem) {
    html {
      scroll-padding-top: 5rem;
    }
  }
</style>
