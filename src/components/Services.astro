---
import { siteConfig } from "../config";
const hasServices = siteConfig.services && siteConfig.services.length > 0;

// ترقيم الخدمات بصيغة رقمين لمحاذاة عمود الأرقام verticals في الشبكة
const serviceNumber = (index: number) => String(index + 1).padStart(2, "0");
---

{
  hasServices && (
    <section
      id="services"
      aria-labelledby="services-heading"
      class="section-shell"
    >
      <div class="layout-container">
        {/* تسمية تمهيدية صغيرة بدل الشريط الزخرفي: تلوين مفرد بالaccent ونص متتبّع */}
        <p class="section-eyebrow">
          What I build
        </p>

        <div class="section-intro">
          <h2 class="section-title" id="services-heading">
            Services
          </h2>

          <p class="lead-copy">
            {siteConfig.aboutMe}
          </p>
        </div>

        {/* قائمة تحريرية: خطوط فاصلة بدل الصناديق، مع تدرّج بصري عند التحويم */}
        <ul class="section-content border-b border-line">
          {siteConfig.services.map((service, index) => (
            <li class="group relative divided-row border-t service-row">
              {/* نقلة الحافة من اليسار — الحركة الوحيدة في القسم.
                  motion-safe: يجعل قاعدة التحويم لا تُكتب أصلاً إلا في وضع
                  no-preference، فيستحيل أن تتغلب motion-reduce عليها مهما تغيّر
                  ترتيب القواعد في CSS. هذا نفس النمط المطبّق في Work وCapabilities. */}
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-standard ease-standard motion-safe:group-hover:scale-x-100 motion-safe:group-focus-within:scale-x-100"
              />

              {/* الترقيم نص مرئي فعلياً: gray-500 يضمن 4.5:1 (gray-400 كان 2.6:1 ويخالف AA) */}
              <p
                aria-hidden="true"
                class="text-sm tabular-nums text-muted transition-colors duration-fast motion-safe:group-hover:text-accent"
              >
                {serviceNumber(index)}
              </p>

              <h3 id={`service-${index + 1}`} class="row-title">
                {service.title}
              </h3>

              <p class="body-copy">
                {service.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
