---
import { siteConfig } from "../config";
import CaseStudy from "./CaseStudy.astro";

const hasCaseStudies = siteConfig.caseStudies && siteConfig.caseStudies.length > 0;
---

{
  hasCaseStudies && (
    <section
      id="work"
      aria-labelledby="work-heading"
      class="section-shell work-shell"
    >
      <div class="layout-container">
        {/* تسمية تمهيدية بنفس نظام Services ليبقى تسلسل القراءة متسقاً عبر الأقسام */}
        <p class="section-eyebrow">
          Case studies
        </p>

        {/* h2 يأخذ العرض الكامل: يمنع التفافه إلى سطرين ويمنح دراسة الحالة مساحة كافية */}
        <h2 id="work-heading" class="section-title section-heading-standalone">
          Selected Work
        </h2>

        <div class="case-study-list">
          {siteConfig.caseStudies.map((study, index) => (
            <CaseStudy study={study} index={index} />
          ))}
        </div>
      </div>
    </section>
  )
}
