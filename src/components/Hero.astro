---
import { siteConfig } from "../config";

// وجهات موجودة أصلاً في config — لا مسار جديد ولا رابط مخترع
const hasWork = Boolean(siteConfig.caseStudies?.length);
const email = siteConfig.social?.email;
---

{
  (
    <section
      id="hero"
      aria-labelledby="hero-heading"
      class="hero-shell"
    >
      <div class="layout-container">
        {/* تسمية تمهيدية هادئة بنفس نظام الأقسام التي تحته */}
        <p class="section-eyebrow hero-enter">
          {siteConfig.title}
        </p>

        {/* الاسم هو العنصر المهيمن وحده: بلا "I'm" وبلا تحيّة وبلا سطر منفصل،
            والحجم محسوب على أن يبقى سطراً واحداً حتى 320px */}
        <h1
          id="hero-heading"
          class="display-title hero-name hero-enter hero-enter-1"
        >
          {siteConfig.name}
        </h1>

        {/* خط شعري كامل العرض يثبّت الإيقاع أفقياً ويمنع около النص فراغاً غير مقصود */}
        <div class="hero-divider border-t border-line">
          {/* الجملة من aboutMe: تجيب عن "ماذا يبني" و"كيف يعمل" في صيغة المتكلم،
              وهي نفس جملة Services التالية — انظر الملاحظة في التقرير */}
          <p class="lead-copy hero-enter hero-enter-2">
            {siteConfig.aboutMe}
          </p>

          <div class="hero-actions hero-enter hero-enter-3">
            {hasWork && (
              <a
                href="#work"
                class="group action-link action-link-primary gap-2 text-base sm:text-lg font-medium"
              >
                View selected work
                <span
                  aria-hidden="true"
                  class="transition-transform duration-standard ease-standard motion-safe:group-hover:translate-x-1"
                >
                  →
                </span>
              </a>
            )}

            {email && (
              <>
                {/* فاصل شعري بين الإجراءين — لا يحمل معلومات، مخفي على الشاشات الصغيرة */}
                <span
                  aria-hidden="true"
                  class="hidden sm:block h-5 w-px bg-line"
                />

                <a
                  href={`mailto:${email}`}
                  class="action-link text-base sm:text-lg text-body"
                >
                  Email
                </a>
              </>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* The content remains visible when animation is unavailable or reduced. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes heroEnter {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-enter {
      animation: heroEnter var(--motion-enter) var(--ease-standard) both;
    }

    .hero-enter-1 {
      animation-delay: 0.08s;
    }

    .hero-enter-2 {
      animation-delay: 0.16s;
    }

    .hero-enter-3 {
      animation-delay: 0.24s;
    }
  }
</style>
