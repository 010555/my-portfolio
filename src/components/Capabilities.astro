---
import { siteConfig } from "../config";
const hasCapabilities = siteConfig.capabilities && siteConfig.capabilities.length > 0;

// ترقيم بفارغين لمحاذاة عمود الأرقام عمودياً في الشبكة
const areaNumber = (index: number) => String(index + 1).padStart(2, "0");

// خريطة عرض فقط: البيانات (items) تبقى من config كما هي، والتسميات والأوصاف
// إعادة صياغة للمجموعات نفسها من زاوية "كيف أعمل" بدل "ما الأدوات".
// config خارج نطاق التعديل، فالتسميات تعيش في المكوّن كما يعيش عنوان h2 هناك.
const AREA: Record<string, { label: string; note: string }> = {
  Backend: {
    label: "Application Structure",
    // مستمدة من aboutMe: "role-based access, clear workflows, and a REST API behind the interface"
    note: "Role-based access, clear workflows, and a REST API behind the interface.",
  },
  Frontend: {
    label: "Interface Development",
    // مستمدة من services[1].description
    note: "Role-based dashboards and internal tools that give teams one place to view and update operational data.",
  },
  Testing: {
    label: "Verification",
    // مستمدة من caseStudies[0].outcomes[2]
    note: "Automated backend, frontend, and end-to-end test coverage.",
  },
};
---

{
  hasCapabilities && (
    <section
      id="capabilities"
      aria-labelledby="capabilities-heading"
      class="section-shell"
    >
      <div class="layout-container">
        {/* تسمية تمهيدية بنفس نظام Services وWork: لون accent واحد ونص متتبّع */}
        <p class="section-eyebrow">
          How I work
        </p>

        <div class="section-intro">
          <h2 id="capabilities-heading" class="section-title">
            Capabilities
          </h2>

          {/* الجملة التمهيدية تغيّر الإطار منجرد الأدوات إلى تسلسل العمل،
              ولا تضيف ادعاءً جديداً: ترتيب المجموعات في config هو ترتيب العمل */}
          <p class="lead-copy">
            These are ordered the way the work runs: structure first, then the
            interface, then verification.
          </p>
        </div>

        {/* صفوف تحريرية مرقّمة: خطوط فاصلة بدل الصناديق والشارات */}
        <ul class="section-content border-b border-line">
          {siteConfig.capabilities.map((capability, index) => {
            const area = AREA[capability.group];
            return (
              <li class="group relative divided-row border-t capability-row">
                {/* خط accent يظهر تدريجياً من اليسار — الحركة الوحيدة في القسم */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-standard ease-standard motion-safe:group-hover:scale-x-100"
                />

                {/* الترقيم مرئي فعلياً: gray-500 يحقق 4.5:1 */}
                <p
                  aria-hidden="true"
                  class="text-sm tabular-nums text-muted transition-colors duration-fast motion-safe:group-hover:text-accent"
                >
                  {areaNumber(index)}
                </p>

                  <div>
                  {/* نُبقي id المجموعة القديم كما هو حتى لا تنكسر الروابط العميقة */}
                  <h3
                    id={`capability-group-${capability.group.toLowerCase()}`}
                    class="row-title"
                  >
                    {area ? area.label : capability.group}
                  </h3>

                  {area && (
                    <p class="supporting-copy mt-3 max-w-[46ch]">
                      {area.note}
                    </p>
                  )}
                </div>

                {/* الأدوات نص عادي بفاصل رأسي رفيع لكل عنصر — بلا شارات ولا أيقونات */}
                <ul class="flex flex-wrap items-start gap-x-4 gap-y-2.5">
                  {capability.items.map((item) => (
                    <li class="border-l border-line pl-4 supporting-copy">
                      {item}
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
