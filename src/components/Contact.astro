---
import { siteConfig } from "../config";
const hasContact = !!siteConfig.social?.email;
const email = siteConfig.social?.email;
---

{
  hasContact && (
    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="section-shell contact-shell"
    >
      <div class="layout-container">
        {/* الجملة التمهيدية تنقسم إلى تسمية تمهيدية وسطر دعم بدل تكرار كلمة
            "Contact" مرتين. الاثنان من النص الموجود أصلاً في config — لا نسخ مخترع. */}
        <p class="section-eyebrow">
          Get in touch
        </p>

        <div class="section-intro">
          <h2 id="contact-heading" class="section-title">
            Contact
          </h2>

          <p class="lead-copy">
            Have a project, system, or dashboard you need built or improved?
          </p>
        </div>

        {/* ---------- الإجراء الأساسي: رابط نصي كبير لا زرّ معبّأ ----------
            break-all ضروري: البريد 22 محرفاً بلا مسافات، و IBM Plex Mono
            عرضه 0.6em لكل محرف، فأي حجم عرض > 18px يتجاوز صندوق 256px عند
            320px. break-all يجعل الكسر مسموحاً فلا يفيض المستند مهما تغيّر
            العرض، وهي نفس الحاية التي أثبتتها QA على الإصدار السابق.

            py-2 مع -my-2: يرفع منطقة النقر إلى 44px كما في روابط social
            أدناه، والهامش السالب يعيد المحاذاة الأصلية فلا يتزحزح شيء
            بصرياً. الحشو على inline-block لا يكسر الالتفاف. */}
        <div class="contact-primary">
          <a
            href={`mailto:${email}`}
            class="group contact-email"
          >
            {email}
            {/* السهم inline-block لا سبيان: التحول لا يعمل على inline غير
                مُستبدل، ولولا ذلك لبقي السهم ثابتاً بلا حركة */}
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-standard ease-standard motion-safe:group-hover:translate-x-1"
            >
              →
            </span>
          </a>
        </div>

        {/* ---------- روابط ثانوية: نص عادي بلا أيقونات، سهم ↗ لهدف خارجي ---------- */}
        <ul class="contact-links">
          {siteConfig.social?.github && (
            <li>
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group action-link gap-1.5 text-base sm:text-lg text-body"
              >
                GitHub
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-standard ease-standard motion-safe:group-hover:translate-x-1"
                >
                  ↗
                </span>
              </a>
            </li>
          )}
          {siteConfig.social?.linkedin && (
            <li>
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="group action-link gap-1.5 text-base sm:text-lg text-body"
              >
                LinkedIn
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-standard ease-standard motion-safe:group-hover:translate-x-1"
                >
                  ↗
                </span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </section>
  )
}
