---
import { siteConfig } from "../config";
const hasContact = !!siteConfig.social?.email;
const email = siteConfig.social?.email;
---

{
  hasContact && (
    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="p-8 sm:p-12 md:p-16 lg:p-24"
      style={`--contact-accent: ${siteConfig.accentColor}`}
    >
      <div>
        {/* الجملة التمهيدية تنقسم إلى تسمية تمهيدية وسطر دعم بدل تكرار كلمة
            "Contact" مرتين. الاثنان من النص الموجود أصلاً في config — لا نسخ مخترع. */}
        <p class="text-xs sm:text-[0.8125rem] font-medium uppercase tracking-[0.18em] text-[var(--contact-accent)]">
          Get in touch
        </p>

        <div class="mt-6 sm:mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <h2 id="contact-heading" class="lg:col-span-4 text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 tracking-[-0.02em]">
            Contact
          </h2>

          <p class="lg:col-span-8 text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600 max-w-[58ch]">
            Have a project, system, or dashboard you need built or improved?
          </p>
        </div>

        {/* ---------- الإجراء الأساسي: رابط نصي كبير لا زرّ معبّأ ----------
            break-all ضروري: البريد 22 محرفاً بلا مسافات، و IBM Plex Mono
            عرضه 0.6em لكل محرف، فأي حجم عرض > 18px يتجاوز صندوق 256px عند
            320px. break-all يجعل الكسر مسموحاً فلا يفيض المستند مهما تغيّر
            العرض، وهي نفس الحاية التي أثبتتها QA على الإصدار السابق.

            py-2 مع -my-2: يرفع منطقة النقر إلى 44px كما في روابط social
            أدناه، والهامش السالب يعيد المحاذاة الأصلية فلا يتزحزح شيء
            بصرياً. الحشو على inline-block لا يكسر الالتفاف. */}
        <div class="mt-12 sm:mt-16 lg:mt-20 border-t border-gray-200 pt-8 sm:pt-10 lg:pt-12">
          <a
            href={`mailto:${email}`}
            class="group inline-block max-w-full break-all py-2 -my-2 text-lg sm:text-2xl md:text-3xl lg:text-4xl font-semibold tracking-[-0.01em] text-gray-900 underline decoration-gray-300 underline-offset-[6px] transition-colors duration-300 motion-safe:hover:text-[var(--contact-accent)] motion-safe:hover:decoration-[var(--contact-accent)] motion-reduce:transition-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--contact-accent)]"
          >
            {email}
            {/* السهم inline-block لا سبيان: التحول لا يعمل على inline غير
                مُستبدل، ولولا ذلك لبقي السهم ثابتاً بلا حركة */}
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:group-hover:translate-x-1 motion-reduce:transition-none"
            >
              →
            </span>
          </a>
        </div>

        {/* ---------- روابط ثانوية: نص عادي بلا أيقونات، سهم ↗ لهدف خارجي ---------- */}
        <ul class="mt-12 sm:mt-16 border-t border-gray-200 pt-8 sm:pt-10 flex flex-wrap items-center gap-x-8 gap-y-2">
          {siteConfig.social?.github && (
            <li>
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-1.5 min-h-[44px] text-base sm:text-lg text-gray-600 transition-colors duration-300 motion-safe:hover:text-[var(--contact-accent)] motion-reduce:transition-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--contact-accent)]"
              >
                GitHub
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:group-hover:translate-x-1 motion-reduce:transition-none"
                >
                  ↗
                </span>
              </a>
            </li>
          )}
          {siteConfig.social?.linkedin && (
            <li>
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-1.5 min-h-[44px] text-base sm:text-lg text-gray-600 transition-colors duration-300 motion-safe:hover:text-[var(--contact-accent)] motion-reduce:transition-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--contact-accent)]"
              >
                LinkedIn
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:group-hover:translate-x-1 motion-reduce:transition-none"
                >
                  ↗
                </span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </section>
  )
}
